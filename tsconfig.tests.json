{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "lib/messaging/text-envelope.ts",
    "lib/messaging/people.ts",
    "lib/auth/validation.ts",
    "lib/server/portways-config.ts",
    "lib/server/message-envelope.ts",
    "tests/**/*.test.ts"
  ]
}
