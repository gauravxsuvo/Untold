# Local development: use the Portways database bridge on loopback.
# A linked Portways Postgres add-on injects DATABASE_URL in the hosted project.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE?sslmode=disable

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: instant message delivery. Without it, the app polls every few seconds.
ABLY_API_KEY=

# Admin access: use the email of your existing approved account.
# New signups wait for approval at /access. Review them in Settings > Account requests.
ADMIN_EMAIL=
# Recommended: pin your admin account ID. Required when the admin account is new
# after migration 015. Its waiting page shows the account reference to that email.
ADMIN_USER_ID=

# Portways managed TURN: injected by Portways. Never use a NEXT_PUBLIC_ or VITE_ prefix.
# The server exchanges TURN_TOKEN for temporary ICE credentials via TURN_API_URL.
TURN_API_URL=
TURN_TOKEN=
# Set true only to force relay connectivity checks (or enforce relay-only privacy).
# Default false uses normal ICE selection and permits STUN fallback on relay outages.
TURN_RELAY_ONLY=false

# Optional legacy standard TURN REST relay. Managed Portways settings take priority.
# Comma-separated example: turns:relay.example.com:443?transport=tcp,turn:relay.example.com:3478?transport=udp
TURN_URLS=
TURN_SHARED_SECRET=

# Optional locally; link a Portways Object Storage (S3) add-on to enable attachments.
# Keep all S3 credentials server-only. Portways injects these values for linked projects.
S3_ENDPOINT=
S3_INTERNAL_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=

# Set BETTER_AUTH_URL to the public HTTPS project URL on Portways, for example:
# BETTER_AUTH_URL=https://untold.portways.app
